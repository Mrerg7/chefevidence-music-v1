---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found — ChefEvidence" description="Page not found on ChefEvidence." noindex={true}>
  <main class="flex min-h-dvh flex-col items-center justify-center bg-[var(--color-void)] px-6 py-16 text-center">
    <p class="text-base uppercase tracking-[0.28em] text-white/40">404</p>
    <h1 class="mt-4 text-2xl font-medium text-[var(--color-ghost)] sm:text-3xl">Page not found</h1>
    <p class="mt-3 max-w-md text-base leading-relaxed text-white/50">
      The page you requested does not exist.
    </p>
    <a
      href="/"
      class="mt-8 inline-flex min-h-12 min-w-[11rem] items-center justify-center rounded-full border border-white/10 bg-black/30 px-8 py-3.5 text-base font-medium tracking-[0.18em] uppercase text-[var(--color-whisper)] backdrop-blur-md transition-all duration-700 hover:border-white/25 hover:bg-black/45 hover:text-[var(--color-ghost)] focus:outline-none focus-visible:ring-1 focus-visible:ring-white/30"
    >
      Home
    </a>
  </main>
</Layout>
